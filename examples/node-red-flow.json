    {
        "id": "a1f0c0de00000004",
        "type": "function",
        "z": "a1f0c0de00000001",
        "name": "Build WordPress payload",
        "func": "const current = msg.payload && msg.payload.current;\n\nif (msg.statusCode !== 200 || !current) {\n    node.warn('No weather data received, skipping this update.');\n    return null;\n}\n\n// One request updates several keys at once.\nmsg.payload = {\n    whistler_temp: current.temperature_2m,\n    whistler_wind_speed: current.wind_speed_10m,\n    whistler_wind_dir: current.wind_direction_10m\n};\n\nmsg.method = 'POST';\nmsg.url = env.get('WP_URL').replace(/\\/$/, '') + '/wp-json/nrwp/v1/data';\nmsg.headers = {\n    'Content-Type': 'application/json',\n    'X-NRWP-Token': env.get('NRWP_TOKEN')\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 80,
        "wires": [
            [
                "a1f0c0de00000005"
            ]
        ]
    },
