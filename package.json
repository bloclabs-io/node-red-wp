{
	"name": "node-red-wp",
	"version": "2.0.0",
	"private": true,
	"description": "Development tooling and tests for the Node-RED WordPress plugin.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.9"
	},
	"scripts": {
		"lint:php": "composer lint",
		"lint:js": "node --check assets/js/nrwp.js && node --check blocks/data/index.js",
		"wp:setup": "tests/bin/setup-wordpress.sh",
		"test": "node --test --test-concurrency=1 tests/*.test.mjs",
		"test:rest": "node --test tests/rest.test.mjs",
		"test:node-red": "node --test tests/node-red.test.mjs",
		"test:e2e": "node --test tests/e2e.test.mjs",
		"build:zip": "bin/build-zip.sh",
		"lint:syntax": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -not -path './.wp-test/*' -print0 | xargs -0 -n1 php -l"
	},
	"devDependencies": {
		"node-red": "^5.0.7",
		"playwright": "1.56.1"
	}
}
