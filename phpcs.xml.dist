<?xml version="1.0"?>
<ruleset name="Node-RED WordPress">
	<description>Coding standards for the Node-RED WordPress plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/.wp-test/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- Hook callbacks keep their 0.x action__/filter__/endpoint__ naming. -->
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodDoubleUnderscore"/>
	</rule>

	<!-- block.json requires the "<script>.asset.php" naming. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/blocks/*/index.asset.php</exclude-pattern>
	</rule>

	<!-- Registered by Jetpack. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="view_stats"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="node-red-wp"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="nrwp"/>
				<element value="node_red_wp"/>
			</property>
		</properties>
	</rule>
</ruleset>
